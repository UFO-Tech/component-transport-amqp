{
    "name": "ufo-tech/component-transport-amqp",
    "description": "AMQP async transport resolver for the UFO JSON-RPC client SDK.",
    "authors": [
        {
            "name": "Alex Maistrenko",
            "email": "ashterix69@gmail.com"
        }
    ],
    "type" : "library",
    "license": "MIT",
    "keywords": [
        "json-rpc",
        "sdk",
        "amqp",
        "async",
        "messenger"
    ],
    "homepage": "https://github.com/UFO-Tech/component-transport-amqp",
    "require": {
        "php": ">=8.3",
        "ext-amqp": "*",
        "ufo-tech/component-transport-contracts": "^1",
        "symfony/amqp-messenger": "^7.2",
        "symfony/messenger": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Ufo\\Component\\AsyncAmqpTransport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ufo\\Component\\AsyncAmqpTransport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
